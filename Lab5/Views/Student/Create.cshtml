@model Lab5.Models.Student
@{
    ViewData["Title"] = "Create Student";
}
<h1>Add New Student</h1>
<form asp-action="Create" method="post">
    <div>
        <label asp-for="Name">
            Name
        </label>
        <input asp-for="Name" />
    </div>
    <br />
    <div>
        <label asp-for="Address">
            Address
        </label>
        <input asp-for="Address" />
    </div>
    <br />
    <div>
        <label asp-for="Phone">
            Phone
        </label>
        <input asp-for="Phone" />
    </div>
    <br />
    <div>
        <label asp-for="Program">
            Program
        </label>
        <select asp-for="Program">
            <option value="">
                -- Select Program --
            </option>
            @foreach (var program in ViewBag.Programs)
            {
                <option value="@program">
                    @program
                </option>
            }
        </select>
    </div>
    <br />
    <div>
        <label asp-for="Semester">
            Semester
        </label>
        <input asp-for="Semester"
            type="number"
            min="1"
            max="8" />
    </div>
    <br />
    <div>
        <label asp-for="GPA">
            GPA
        </label>
        <input asp-for="GPA"
            type="number"
            step="0.01" />
    </div>
    <br />
    <button type="submit">
        Save Student
    </button>
    <a asp-action="Index">
        Cancel
    </a>
</form>
@section Scripts
{
    <script>
        alert("Create Student page loaded.");
    </script>
}