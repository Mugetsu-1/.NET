@model Lab5.Models.Student
@{
    ViewData["Title"] = "Student Details";
    string performance;
    if (Model.GPA >= 3.5)
    {
        performance = "Excellent";
    }
    else if (Model.GPA >= 3.0)
    {
        performance = "Good";
    }
    else
    {
        performance = "Needs Improvement";
    }
}
<h1>Student Details</h1>
<p>@ViewBag.PageMessage</p>
<table border="1" cellpadding="8">
    <tr>
        <th>Student ID</th>
        <td>@Model.StudentId</td>
    </tr>
    <tr>
        <th>Name</th>
        <td>@Model.Name</td>
    </tr>
    <tr>
        <th>Address</th>
        <td>@Model.Address</td>
    </tr>
    <tr>
        <th>Phone</th>
        <td>@Model.Phone</td>
    </tr>
    <tr>
        <th>Program</th>
        <td>@Model.Program</td>
    </tr>
    <tr>
        <th>Semester</th>
        <td>@Model.Semester</td>
    </tr>
    <tr>
        <th>GPA</th>
        <td>@Model.GPA</td>
    </tr>
    <tr>
        <th>Performance</th>
        <td>@performance</td>
    </tr>
</table>
<br />
<a asp-action="Index">
    Back to Student List
</a>
@section Scripts
{
    <script>
        alert("Student Details page loaded.");
    </script>
}