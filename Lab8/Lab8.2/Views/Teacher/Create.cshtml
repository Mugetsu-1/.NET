@model Lab8._2.Models.Teacher
@{
    ViewData["Title"] = "Create Teacher";
}

<h2>Create Teacher</h2>
<form asp-action="Create" class="col-md-4">
    <div class="mb-2"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /></div>
    <div class="mb-2"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /></div>
    <div class="mb-2"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" /></div>
    <div class="mb-2"><label asp-for="Subject" class="form-label"></label><input asp-for="Subject" class="form-control" /></div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>
