@model List<Student>
@{
    ViewData["Title"] = "Student Index";
}

<h2>@ViewData["Heading"]</h2>

@if (TempData["msg"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["msg"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<a class="btn btn-primary mb-3" asp-action="Create">+ Add New Student</a>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Roll No</th>
            <th>Dept</th>
            <th>Semester</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.Id</td>
                <td>@s.Name</td>
                <td>@s.RollNo</td>
                <td>@s.Dept</td>
                <td>@s.Semester</td>
                <td>
                    <a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@s.Id">Details</a>
                    <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@s.Id">Edit</a>
                    <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@s.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>