@model Student

<form asp-action="@ViewContext.RouteData.Values["action"]" method="post">
    @if (Model.Id != 0)
    {
        <input type="hidden" asp-for="Id" />
    }

    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="RollNo" class="form-label"></label>
        <input asp-for="RollNo" class="form-control" />
        <span asp-validation-for="RollNo" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Dept" class="form-label"></label>
        <input asp-for="Dept" class="form-control" />
        <span asp-validation-for="Dept" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Semester" class="form-label"></label>
        <input asp-for="Semester" class="form-control" />
        <span asp-validation-for="Semester" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">@ViewData["Submit"]</button>
    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
</form>